# Copie este arquivo para .env e preencha com a sua chave.
# Gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo do Gemini usado na reescrita (opcional).
# Para ver os modelos liberados para a sua chave, veja o README.
GEMINI_MODEL=gemini-3.5-flash-lite

# Novas tentativas quando o Gemini falha temporariamente (429 ou 5xx), com
# backoff exponencial: 1 s, 2 s, 4 s, 8 s... (com variação aleatória), até o teto.
GEMINI_TENTATIVAS=5
GEMINI_ESPERA_INICIAL=1
GEMINI_ESPERA_MAXIMA=16
